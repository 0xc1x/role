node_modules/
dist/
.expo/
coverage/
*.log
.DS_Store
.env
.env.local
.env.*.local
.turbo/
.opencode/
.vercel
.zcode
.pi
# drizzle generated — no commitear el schema dump en repo público
apps/api/drizzle/
# Local AI runtime state
.atl/
# TanStack Start build cache
apps/admin/.tanstack/
# CodeGraph local knowledge-graph index — 41 MB of machine-local state that
# regenerates on demand. Never belongs in a public repo.
.codegraph/
# Deno lockfile for Edge Functions. Generated by `deno check` in CI/dev, not a
# published artifact, and its root placement makes tooling pick it up for
# unrelated scripts. Regenerate locally when needed.
deno.lock

# Playwright MCP session artifacts (browser logs and page snapshots)
.playwright-mcp/

# Playwright runner output. Traces, screenshots and the HTML report are
# regenerated on every run and are only useful right after a failure; they
# belong in a CI artifact, not in the tree.
test-results/
playwright-report/
blob-report/
.playwright/

# Output of the `e2e` runner (tester.army) suite. It is resolved relative to
# each app's PROJECT ROOT — the directory holding that app's e2e.config.ts — so
# it lands in apps/<app>/.e2e, never at the monorepo root. Traces, failure
# screenshots, the server log and report.json are regenerated on every run.
apps/*/.e2e/
