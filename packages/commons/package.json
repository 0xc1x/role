{
  "name": "@0xc1x/role-commons",
  "version": "1.0.0",
  "private": true,
  "description": "Shared DTOs, entities, enums and Zod schemas for Role apps and APIs",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.json && bun scripts/fix-imports.mjs",
    "clean": "rm -rf dist",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
