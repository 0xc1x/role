    "/api/v1/upload/image": {
      "post": {
        "operationId": "UploadController_uploadImage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Archivo de imagen y opciones de bucket/folder",
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadImageBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imagen subida y comprimida a WebP. La URL pública se devuelve en el cuerpo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://[project].supabase.co/storage/v1/object/public/images/categories/uuid.webp"
                    }
                  },
                  "required": [
                    "url"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Archivo inválido, formato no soportado o excede el tamaño máximo"
          },
          "401": {
            "description": "No autorizado"
          },
          "403": {
            "description": "Requiere rol admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload an image (admin)",
        "tags": [
          "Upload"
        ]
      }
    },
