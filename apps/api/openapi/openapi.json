  "info": {
    "title": "Role API",
    "description": "Backend API para Role — marketplace de comida excedente",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "UploadImageBody": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Archivo de imagen (jpeg, png, webp)"
          },
          "bucket": {
            "type": "string",
            "description": "Nombre del bucket en Supabase (opcional, por defecto el del .env)",
            "example": "public-assets"
          },
          "folder": {
            "type": "string",
            "description": "Carpeta dentro del bucket (opcional, por defecto \"categories\")",
            "example": "categories"
          }
        },
        "required": [
          "file"
        ]
      }
    }
  }
