NODE_ENV=development
PORT=3000

# Supabase Postgres (prefer Transaction pooler :6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project
SUPABASE_URL=https://[project-ref].supabase.co
# JWT secret from Project Settings → API → JWT Secret (HS256 fallback; ES256 via JWKS)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# anon / publishable key from Project Settings → API
SUPABASE_ANON_KEY=your-supabase-anon-key
# service_role key (secret) from Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage bucket for images (created manually in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=images

# Comma-separated allowed buckets (allowlist)
SUPABASE_ALLOWED_BUCKETS=images

# Comma-separated allowed folders (allowlist)
SUPABASE_ALLOWED_FOLDERS=categories

# Comma-separated origins, or * for all
CORS_ORIGINS=*

# ─── Email marketing (Resend) ──────────────────────────────────────────
# Sin RESEND_API_KEY el envío real está deshabilitado (modo simulado en dev).
RESEND_API_KEY=
EMAIL_FROM="Rolé <no-reply@role.app>"
# Secreto de firma del webhook de Resend (whsec_...). Vacío = sin verificación.
RESEND_WEBHOOK_SECRET=
# Secreto HMAC de tokens de desuscripción. Requerido para enviar campañas reales.
UNSUBSCRIBE_SECRET=
# URL base pública (landing) para enlaces dentro de los emails.
UNSUBSCRIBE_URL_BASE=http://localhost:4001/api/v1/email-marketing/unsubscribe

# ─── Notificaciones push (Fase 2) ──────────────────────────────────────
# Espejo dormido: ENABLE_API_MIRROR_NOTIFICATIONS=false por defecto (Supabase edges siguen activas).
ENABLE_API_MIRROR_NOTIFICATIONS=false
# Redis para BullMQ (vacío = ejecución directa sin cola, útil en dev sin Redis).
REDIS_URL=
# FCM HTTP v1: JSON completo del service account de Firebase (single-line, ver Firebase Console → Project Settings → Service Accounts).
# Vacío deshabilita envío web; Expo push nativo no lo necesita.
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=fudi-abf43
EXPO_ACCESS_TOKEN=
