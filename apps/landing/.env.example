# Base de la API (incluye el prefijo global /api/v1)
VITE_API_URL=http://localhost:4001/api/v1

# Dominio público del sitio: arma el canonical, og:url y el sitemap.xml.
#
# OBLIGATORIA para arrancar. Sin ella el server tira al boot: el destino
# anterior era adivinar `https://role.app` con un warning, y el resultado era un
# deploy de otro dominio announcing el de producción — el sitio entero fuera del
# índice, sin que nada se viera raro en la página.
#
# En Vercel no hace falta declararla si el proyecto tiene
# VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola.
#
# Para desarrollo local, el origen del dev server. El loopback es http a
# propósito: el dev server no atiende TLS, y un canonical https://localhost:3001
# sería un enlace que nadie puede seguir.
VITE_SITE_URL=http://localhost:3001
