# Rolé mobile — variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# Todas las claves son públicas (anon key) — no pongas secretos aquí.

# ── Supabase ──────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Observabilidad ────────────────────────────────────────────────────
# Dejar vacío desactiva Sentry en dev
EXPO_PUBLIC_SENTRY_DSN=

# ── Mapas ─────────────────────────────────────────────────────────────
# Requerido en native para react-native-maps (explore + map picker)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────
# Deep link usado en los correos de recuperación de contraseña
EXPO_PUBLIC_AUTH_RESET_REDIRECT_URL=role://update-password

# ── Entorno ───────────────────────────────────────────────────────────
EXPO_PUBLIC_ENVIRONMENT=development
