{
  "name": "role",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "dev:api": "bun run --cwd apps/api start:dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:commons": "bun run --cwd packages/commons typecheck",
    "deploy:landing": "NITRO_PRESET=vercel bun run build --filter=role-landing... && bun run --cwd apps/landing deploy",
    "deploy:mobile": "bun run --cwd packages/commons build && bun run --cwd apps/mobile deploy"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260817-141030-4bfb35a7"
  }
}
