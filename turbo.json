{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NITRO_PRESET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
