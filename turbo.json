{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "globalEnv": ["NITRO_PRESET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "env": [
        "TEST_DATABASE_URL",
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_API_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_API_URL"
      ]
    },
    "lint": {},
    "format:check": {}
  }
}
